{
  "name": "webboard",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador educacional de robótica e circuitos",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @webboard/web",
    "dev:web": "npm run dev -w @webboard/web",
    "dev:api": "npm run start -w @webboard/api",
    "dev:compiler": "npm run start -w @webboard/compiler-worker",
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "dompurify": "3.4.17",
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  }
}
